# Copier en .env (jamais versionné) puis adapter.

# Base de données : SQLite par défaut en local, PostgreSQL via docker compose.
DATABASE_URL=sqlite:///data/sentinel.db
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel

# Identification polie auprès des sources
HTTP_USER_AGENT=SentinelCTI/0.1 (projet portfolio; contact: ton-email@example.com)
HTTP_TIMEOUT=20
# Pause entre deux requêtes vers un même site (secondes)
HTTP_DELAY=0.5

# Clés API des phases suivantes (gratuites)
NVD_API_KEY=
ABUSECH_AUTH_KEY=
OTX_API_KEY=
